; ============================================
; Power Menu
; ============================================
; Opened by waybar's power button (waybar/scripts/power-menu.sh) together
; with popup-closer.

(defwidget power-item [icon label cmd class]
  (button :class "power-item ${class}"
          :onclick "eww close power-menu popup-closer; ${cmd}"
    (box :orientation "h"
         :space-evenly false
         :spacing 12
      (image :class "power-icon" :icon icon :icon-size "menu")
      (label :class "power-label" :text label :halign "start"))))

(defwidget power-menu []
  (box :class "power-menu"
       :orientation "v"
       :space-evenly false
    (power-item :icon "system-shutdown-symbolic"       :label "Shutdown" :class "shutdown" :cmd "systemctl poweroff")
    (power-item :icon "system-reboot-symbolic"         :label "Reboot"   :class "reboot"   :cmd "systemctl reboot")
    (power-item :icon "media-playback-pause-symbolic"  :label "Suspend"  :class "suspend"  :cmd "systemctl suspend")
    (power-item :icon "system-log-out-symbolic"        :label "Logout"   :class "logout"   :cmd "hyprctl dispatch 'hl.dsp.exit()'")))

; A transparent full-screen window shared by the popups: it dismisses them on
; a click anywhere outside. Closing lists every popup, since eww skips the ones
; that are not open. Hyprland places this window below the bar's exclusive zone
; and eww cannot opt out of it, so a negative margin pulls it back up over the
; bar. 100 px clears the bar at any height; the extra 10% height makes up for
; it at the bottom of the screen.
(defwindow popup-closer
           :monitor 0
           :geometry (geometry :x "0px"
                               :y "-100px"
                               :width "100%"
                               :height "110%"
                               :anchor "top left")
           :stacking "overlay"
           :namespace "eww-popup-closer"
  (eventbox :onclick "eww close power-menu calendar quick-settings popup-closer"
    (box :class "popup-closer")))

; x matches the bar's 10 px edge margin; the bar's exclusive zone puts y 0 at
; its bottom edge, so y is the gap below it.
(defwindow power-menu
           :monitor 0
           :geometry (geometry :x "10px"
                               :y "8px"
                               :width "200px"
                               :anchor "top right")
           :stacking "overlay"
           :namespace "eww-power-menu"
  (power-menu))

; ============================================
; Calendar
; ============================================
; Opened by waybar's clock (waybar/scripts/calendar.sh) together with
; popup-closer. scripts/calendar-month.py fills `cal`, one month at a time.
; Clicking a day runs scripts/calendar-select.sh, which fills `cal-agenda` from
; scripts/calendar-agenda.py and slides it open by setting `cal-selected`.
; scripts/calendar-goto.sh changes month: `cal` is the month on show, and the
; grid's two stack pages hold it and the one being slid to or from.

(defvar cal "{}")
(defvar cal-page 0)
(defvar cal-page-0 '{"weeks": []}')
(defvar cal-page-1 '{"weeks": []}')
(defvar cal-transition "none")
(defvar cal-selected "")
(defvar cal-agenda '{"title": "", "events": [], "notice": ""}')

; Keeps the calendars connected so a click answers in 0.1 s rather than 1 s. It
; prints nothing, so it is empty in the class below; that reference is what makes
; eww run it for exactly as long as the window is open.
(deflisten cal-connections "~/.config/eww/scripts/calendar-agenda.py --hold")

(defwidget calendar-nav [offset class ?halign]
  (button :class "calendar-nav ${class}"
          :halign {halign ?: "fill"}
          :onclick "~/.config/eww/scripts/calendar-goto.sh ${offset} ${cal.offset}"
          :timeout "2s"
    (children)))

(defwidget calendar-event [event]
  (box :class "calendar-event"
       :orientation "v"
       :space-evenly false
    (label :class "calendar-event-title"
           :halign "start"
           :limit-width 28
           :text {event.title})
    (label :class "calendar-event-detail"
           :halign "start"
           :limit-width 34
           :text {event.detail})))

; A `for` re-adds its children at the end of its parent whenever its data
; changes, so it gets a box of its own to keep its place in the panel.
(defwidget calendar-grid [month]
  (box :orientation "v"
       :space-evenly false
    (for week in {month.weeks}
      (box :class "calendar-row"
        (for day in week
          (button :class "calendar-day ${day.cls} ${cal-selected == day.iso ? 'selected' : ''}"
                  :halign "center"
                  :valign "center"
                  :onclick "~/.config/eww/scripts/calendar-select.sh ${day.iso} ${day.offset} ${cal.offset}"
                  :timeout "8s"
            (label :text {day.n})))))))

(defwidget calendar-popup []
  (box :class "calendar${cal-connections}"
       :orientation "v"
       :space-evenly false
    ; centerbox keeps the title on the panel's centre line whatever the width of
    ; the month's name. The title itself is the way back to the current month.
    (centerbox :class "calendar-header"
               :orientation "h"
      (calendar-nav :offset {cal.offset - 1} :class "calendar-arrow" :halign "start"
        (image :icon "go-previous-symbolic" :icon-size "menu"))
      (calendar-nav :offset 0 :class "calendar-title ${cal.offset == 0 ? 'here' : ''}"
        (box :orientation "h"
             :space-evenly false
          (label :class "calendar-month" :text {cal.month})
          (label :class "calendar-year" :text {cal.year})))
      (calendar-nav :offset {cal.offset + 1} :class "calendar-arrow" :halign "end"
        (image :icon "go-next-symbolic" :icon-size "menu")))
    (box :class "calendar-row"
      (for letter in {cal.weekdays}
        (label :class "calendar-weekday" :text letter)))
    (stack :selected {cal-page}
           :transition {cal-transition}
           :same-size true
      (calendar-grid :month {cal-page-0})
      (calendar-grid :month {cal-page-1}))
    (revealer :transition "slidedown"
              :reveal {cal-selected != ""}
              :duration "250ms"
      (box :class "calendar-agenda"
           :orientation "v"
           :space-evenly false
        (label :class "calendar-agenda-title"
               :halign "start"
               :text {cal-agenda.title})
        (box :orientation "v"
             :space-evenly false
          (for event in {cal-agenda.events}
            (calendar-event :event event)))
        ; Centred when it stands in for the events, left under a list of them.
        ; A revealer rather than :visible, because a label built hidden stays
        ; hidden the first time it should appear.
        (revealer :reveal {cal-agenda.notice != ""}
                  :transition "none"
                  :duration "0ms"
                  :halign {arraylength(cal-agenda.events) == 0 ? "center" : "start"}
          (label :class "calendar-agenda-notice"
                 :text {cal-agenda.notice}))))))

; Centred under the clock, which sits in the middle of the bar.
(defwindow calendar
           :monitor 0
           :geometry (geometry :x "0px"
                               :y "8px"
                               :anchor "top center")
           :stacking "overlay"
           :namespace "eww-calendar"
  (calendar-popup))

; ============================================
; Keyboard Layout OSD
; ============================================
; Shown for a moment when the layout changes, by scripts/keyboard-osd.py: every
; configured layout, with the active one highlighted.

(defvar osd-options "[]")

(defwindow keyboard-osd
           :monitor 0
           :geometry (geometry :anchor "center center")
           :stacking "overlay"
           :namespace "eww-keyboard-osd"
  (box :class "keyboard-osd"
    (for option in osd-options
      (box :class "keyboard-osd-option ${option.active ? 'active' : ''}"
           :orientation "v"
           :space-evenly false
           :valign "center"
        (label :class "keyboard-osd-code" :text {option.code})
        (label :class "keyboard-osd-name" :text {option.name})))))

; ============================================
; Quick Settings
; ============================================
; GNOME's system menu: opened by the bar's right-hand modules through
; waybar/scripts/control-panel.sh, closed by popup-closer. scripts/qs-state.py
; supplies `qs` while the panel is open and scripts/qs-action.sh runs the
; clicks. Command lines only ever carry ids from `qs`, never SSIDs or device
; names: those are other people's text, and eww pastes values into a shell.
; Icons are GNOME's symbolic ones, recoloured by GTK to the text colour.

(defvar qs-open "")
(deflisten qs :initial "{}" "~/.config/eww/scripts/qs-state.py")

; The arrow that slides a section open below its row, turning to point down.
(defwidget qs-arrow [section]
  (button :class "qs-arrow ${qs-open == section ? 'open' : ''}"
          :onclick "~/.config/eww/scripts/qs-action.sh expand ${section} ${qs-open}"
          :timeout "2s"
    (image :icon "go-next-symbolic" :icon-size "menu")))

; A round icon button, as in the panel's top row.
(defwidget qs-round [icon action ?class]
  (button :class "qs-round ${class}"
          :onclick "~/.config/eww/scripts/qs-action.sh ${action}"
          :timeout "2s"
    (image :icon icon :icon-size "menu")))

; A pill toggle. With a section it is split, the right end opening the list.
; Without a subtitle the title sits alone in the middle.
(defwidget qs-tile [on icon title action ?subtitle ?section]
  (box :class "qs-tile ${on ? 'on' : ''} ${section != '' ? 'split' : ''}"
       :space-evenly false
    (button :class "qs-tile-main"
            :hexpand true
            :onclick "~/.config/eww/scripts/qs-action.sh ${action}"
            :timeout "10s"
      (box :space-evenly false
        (image :class "qs-tile-icon" :icon icon :icon-size "menu")
        (box :orientation "v"
             :space-evenly false
             :valign "center"
          (label :class "qs-tile-title" :halign "start" :limit-width {section != "" ? 11 : 15} :text title)
          (label :class "qs-tile-subtitle"
                 :visible {subtitle != ""}
                 :halign "start"
                 :limit-width {section != "" ? 14 : 18}
                 :text subtitle))))
    (box :visible {section != ""}
      (qs-arrow :section section))))

(defwidget qs-section [name title icon]
  (revealer :transition "slidedown"
            :reveal {qs-open == name}
            :duration "250ms"
    (box :class "qs-section"
         :orientation "v"
         :space-evenly false
      (box :class "qs-section-header"
           :space-evenly false
        (box :class "qs-section-badge"
          (image :icon icon :icon-size "menu"))
        (label :class "qs-section-title" :halign "start" :text title))
      (children))))

; Takes its icons as arguments: a row inside a `for` that reads `qs` itself
; leaves a listener behind when the list rebuilds ("Scope not in graph"). The
; mark at the end is a tick or a lock; an empty one keeps its space, hidden.
(defwidget qs-row [icon mark name active action]
  (button :class "qs-list-row ${active ? 'active' : ''}"
          :onclick "~/.config/eww/scripts/qs-action.sh ${action}"
          :timeout "30s"
    (box :space-evenly false
      (image :class "qs-list-icon" :icon icon :icon-size "menu")
      (label :class "qs-list-name" :halign "start" :hexpand true :limit-width 30 :text name)
      (image :class "qs-list-mark ${mark == '' ? 'hidden' : ''}"
             :icon {mark != "" ? mark : "object-select-symbolic"}
             :icon-size "menu"))))

(defwidget qs-notice [text]
  ; A revealer rather than :visible, because a label built hidden stays hidden
  ; the first time it should appear.
  (revealer :reveal {text != ""}
            :transition "none"
            :duration "0ms"
            :halign "center"
    (label :class "qs-notice" :text text)))

(defwidget qs-link [text action]
  (button :class "qs-link"
          :onclick "~/.config/eww/scripts/qs-action.sh ${action}"
          :timeout "2s"
    (label :halign "start" :text text)))

(defwidget qs-power-item [label action]
  (button :class "qs-power-item"
          :onclick "~/.config/eww/scripts/qs-action.sh power ${action}"
          :timeout "2s"
    (label :halign "start" :text label)))

(defwidget quick-settings []
  (box :class "quick-settings"
       :orientation "v"
       :space-evenly false
    (box :class "qs-top"
         :space-evenly false
      (box :class "qs-battery"
           :halign "start"
           :space-evenly false
           :visible {qs.battery.present}
        (image :class "qs-battery-icon" :icon {qs.battery.icon} :icon-size "menu")
        (label :class "qs-battery-percent" :text "${qs.battery.percent}%"))
      (box :hexpand true)
      (qs-round :icon "camera-photo-symbolic" :action "screenshot")
      (qs-round :icon "system-lock-screen-symbolic" :action "lock")
      (qs-round :icon "system-shutdown-symbolic"
                :action "expand power ${qs-open}"
                :class {qs-open == "power" ? "open" : ""}))

    ; GNOME's power submenu, opened by the power button above.
    (revealer :transition "slidedown"
              :reveal {qs-open == "power"}
              :duration "250ms"
      (box :class "qs-section qs-power"
           :orientation "v"
           :space-evenly false
        (box :class "qs-section-header"
             :space-evenly false
          (box :class "qs-section-badge"
            (image :icon "system-shutdown-symbolic" :icon-size "large-toolbar"))
          (label :class "qs-section-title" :halign "start" :text "Power Off"))
        (qs-power-item :label "Suspend" :action "suspend")
        (qs-power-item :label "Restart" :action "reboot")
        (qs-power-item :label "Power Off" :action "poweroff")
        (box :class "qs-separator")
        (qs-power-item :label "Log Out" :action "logout")))

    (box :class "qs-slider-row"
         :space-evenly false
      (button :class "qs-slider-icon"
              :onclick "~/.config/eww/scripts/qs-action.sh volume-mute"
              :timeout "2s"
        (image :icon {qs.audio.icon} :icon-size "menu"))
      ; eww's scale stops one short of :max, so 101 is what reaches 100%.
      (scale :class "qs-scale"
             :hexpand true
             :min 0
             :max 101
             :round-digits 0
             :value {qs.audio.percent}
             :onchange "~/.config/eww/scripts/qs-action.sh volume {}"
             :timeout "2s")
      ; GNOME only offers the output list when there is a choice.
      (box :class "qs-slider-end"
        (box :visible {arraylength(qs.audio.sinks ?: []) > 1}
          (qs-arrow :section "audio"))))
    (qs-section :name "audio" :title "Sound Output" :icon "audio-speakers-symbolic"
      (box :orientation "v" :space-evenly false
        (for sink in {qs.audio.sinks}
          (qs-row :icon {sink.icon}
                  :mark {sink.active ? "object-select-symbolic" : ""}
                  :name {sink.name}
                  :active {sink.active}
                  :action "sink ${sink.id}"))))

    (box :class "qs-slider-row"
         :space-evenly false
      (box :class "qs-slider-icon"
        (image :icon {qs.brightness.icon} :icon-size "menu"))
      (scale :class "qs-scale"
             :hexpand true
             :min 1
             :max 101
             :round-digits 0
             :value {qs.brightness.percent}
             :onchange "~/.config/eww/scripts/qs-action.sh brightness {}"
             :timeout "2s")
      (box :class "qs-slider-end"))

    ; The keyboard backlight has a few levels rather than a range (off, low and
    ; high on a ThinkPad), so the knob snaps to them. Hidden without one, and
    ; until `qs` first arrives: ?. reads a missing key as null, not an error.
    (box :class "qs-slider-row"
         :space-evenly false
         :visible {qs.keyboard_backlight?.present ?: false}
      (box :class "qs-slider-icon"
        (image :icon "keyboard-brightness-symbolic" :icon-size "menu"))
      (scale :class "qs-scale"
             :hexpand true
             :min 0
             :max {(qs.keyboard_backlight?.max ?: 1) + 1}
             :round-digits 0
             :value {qs.keyboard_backlight?.level ?: 0}
             :onchange "~/.config/eww/scripts/qs-action.sh keyboard-backlight {}"
             :timeout "2s")
      (box :class "qs-slider-end"))

    (box :class "qs-tile-row"
      (qs-tile :on {qs.wifi.on}
               :icon {qs.wifi.icon}
               :title "Wi-Fi"
               :subtitle {qs.wifi.subtitle}
               :action "wifi-toggle"
               :section "wifi")
      (qs-tile :on {qs.vpn.on}
               :icon {qs.vpn.icon}
               :title "VPN"
               :subtitle {qs.vpn.subtitle}
               :action "vpn ${qs.vpn.on ? 'down' : 'up'} ${qs.vpn.target}"
               :section "vpn"))
    (qs-section :name "wifi" :title "Wi-Fi" :icon "network-wireless-symbolic"
      (box :orientation "v" :space-evenly false
        (for network in {qs.wifi.networks}
          (qs-row :icon {network.icon}
                  :mark {network.mark}
                  :name {network.name}
                  :active {network.active}
                  :action "wifi-connect ${network.connect}")))
      (qs-notice :text {qs.wifi.notice})
      (qs-link :text "All Networks" :action "wifi-settings"))
    (qs-section :name "vpn" :title "VPN" :icon "network-vpn-symbolic"
      (box :orientation "v" :space-evenly false
        (for vpn in {qs.vpn.connections}
          (qs-row :icon {vpn.icon}
                  :mark {vpn.mark}
                  :name {vpn.name}
                  :active {vpn.active}
                  :action "vpn ${vpn.active ? 'down' : 'up'} ${vpn.uuid}")))
      (qs-notice :text {qs.vpn.notice}))

    (box :class "qs-tile-row"
      (qs-tile :on {qs.bluetooth.on}
               :icon {qs.bluetooth.icon}
               :title "Bluetooth"
               :subtitle {qs.bluetooth.subtitle}
               :action "bluetooth-toggle"
               :section "bluetooth")
      (qs-tile :on {qs.night.on}
               :icon "night-light-symbolic"
               :title "Night Light"
               :action "night"))
    (qs-section :name "bluetooth" :title "Bluetooth" :icon "bluetooth-active-symbolic"
      (box :orientation "v" :space-evenly false
        (for device in {qs.bluetooth.devices}
          (qs-row :icon {device.icon}
                  :mark {device.mark}
                  :name {device.name}
                  :active {device.connected}
                  :action "bluetooth-device ${device.mac} ${device.connected ? 'disconnect' : 'connect'}")))
      (qs-notice :text {qs.bluetooth.notice})
      (qs-link :text "Bluetooth Settings" :action "bluetooth-settings"))

    (box :class "qs-tile-row"
      (qs-tile :on {qs.dark.on}
               :icon "dark-mode-symbolic"
               :title "Dark Style"
               :action "dark-style")
      (qs-tile :on {qs.dnd.on}
               :icon "notifications-disabled-symbolic"
               :title "Do Not Disturb"
               :action "dnd"))

    (box :class "qs-tile-row"
      (qs-tile :on false
               :icon "input-keyboard-symbolic"
               :title "Keyboard"
               :subtitle {qs.keyboard.layout}
               :action "keyboard-next ${qs.keyboard.device}"
               :section "keyboard")
      (qs-tile :on {qs.airplane.on}
               :icon "airplane-mode-symbolic"
               :title "Airplane Mode"
               :action "airplane"))
    (qs-section :name "keyboard" :title "Keyboard" :icon "input-keyboard-symbolic"
      (box :orientation "v" :space-evenly false
        (for layout in {qs.keyboard.layouts}
          (qs-row :icon "input-keyboard-symbolic"
                  :mark {layout.mark}
                  :name {layout.name}
                  :active {layout.active}
                  :action "keyboard-layout ${qs.keyboard.device} ${layout.index}"))))))

(defwindow quick-settings
           :monitor 0
           :geometry (geometry :x "10px"
                               :y "8px"
                               :anchor "top right")
           :stacking "overlay"
           :namespace "eww-quick-settings"
  (quick-settings))

; ============================================
; Volume and Brightness OSD
; ============================================
; Shown for a moment in the middle of the screen by scripts/level-osd.py, which
; the volume, brightness and mic-mute keys run (hypr/hyprland.lua): the icon and
; a bar like the panel's sliders. The mic shows its icon alone, as in GNOME.
; scripts/keyboard-backlight-osd.py shows the keyboard backlight here too, when
; the laptop's own key changes it.

(defvar level-osd '{"icon": "audio-volume-high-symbolic", "value": 0, "bar": true}')

(defwindow level-osd
           :monitor 0
           :geometry (geometry :anchor "center center")
           :stacking "overlay"
           :namespace "eww-level-osd"
  (box :class "level-osd"
       :space-evenly false
    (image :class "level-osd-icon" :icon {level-osd.icon} :icon-size "large-toolbar")
    (revealer :reveal {level-osd.bar}
              :transition "none"
              :duration "0ms"
      (progress :class "level-osd-bar"
                :valign "center"
                :value {level-osd.value}))))

; ============================================
; Low Battery Warning
; ============================================
; Opened in the middle of the screen by scripts/battery-warning.py (the
; battery-warning user service) when the charge falls to 20% and to 5%. A click
; anywhere on it dismisses it.

(defvar battery-warning '{"icon": "battery-level-20-symbolic", "title": "", "text": "", "critical": false}')

(defwindow battery-warning
           :monitor 0
           :geometry (geometry :anchor "center center")
           :stacking "overlay"
           :namespace "eww-battery-warning"
  (eventbox :onclick "eww close battery-warning"
            :cursor "pointer"
    (box :class "battery-warning ${battery-warning.critical ? 'critical' : ''}"
         :orientation "v"
         :space-evenly false
      (image :class "battery-warning-icon" :icon {battery-warning.icon} :icon-size "dialog")
      (label :class "battery-warning-title" :text {battery-warning.title})
      (label :class "battery-warning-text" :text {battery-warning.text})
      (label :class "battery-warning-hint" :text "Click to dismiss"))))
