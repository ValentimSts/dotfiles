{
    "window.zoomLevel": 1,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "files.autoSave": "afterDelay",
    "git.confirmSync": false,
    "git.autofetch": true,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "security.workspace.trust.untrustedFiles": "open",
    "python.analysis.typeCheckingMode": "standard",
    "files.exclude": {
        "**/__pycache__": true
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "chat.tools.terminal.autoApprove": {
        "pdflatex": true,
        "cat > renderer.h << 'EOF'\n#ifndef _DS_RENDERER_H_\n#define _DS_RENDERER_H_\n\ntypedef struct Renderer Renderer;\ntypedef struct DataStructure DataStructure;\n\ntypedef struct RendererVTable {\n    void (*draw)(Renderer* renderer, DataStructure* ds, int x, int y, int width, int height);\n    void (*draw_stats)(Renderer* renderer, DataStructure* ds, int x, int y);\n    void (*destroy)(Renderer* renderer);\n} RendererVTable;\n\nstruct Renderer {\n    RendererVTable* vtable;\n};\n\nvoid renderer_destroy(Renderer* r);\n\n#endif\nEOF": {
            "approve": true,
            "matchCommandLine": true
        },
        "cat > renderer.c << 'EOF'\n#include \"renderer.h\"\n#include <stdlib.h>\n\nvoid renderer_destroy(Renderer* r){\n    if (!r) return;\n    if (r->vtable && r->vtable->destroy) {\n        r->vtable->destroy(r);\n    }\n}\nEOF": {
            "approve": true,
            "matchCommandLine": true
        },
        "cat > data_structure.h << 'EOF'\n#ifndef _DS_DATA_STRUCTURE_H_\n#define _DS_DATA_STRUCTURE_H_\n\n#include \"entry.h\"\n#include \"renderer.h\"\n#include <stdbool.h>\n\ntypedef struct DataStructure DataStructure;\n\ntypedef struct DataStructureVTable {\n    void (*destroy)(DataStructure* ds);\n    bool (*insert)(DataStructure* ds, Data* data);\n    bool (*update)(DataStructure* ds, const char* key, const char* new_value);\n    bool (*remove)(DataStructure* ds, const char* key);\n    Data* (*search)(DataStructure* ds, const char* key);\n    size_t (*size)(DataStructure* ds);\n    bool (*is_empty)(DataStructure* ds);\n    void (*clear)(DataStructure* ds);\n} DataStructureVTable;\n\nstruct DataStructure {\n    DataStructureVTable* vtable;\n    Renderer* renderer;\n    char* type_name;\n};\n\nvoid ds_destroy(DataStructure* ds);\nbool ds_insert(DataStructure* ds, Data* data);\nbool ds_update(DataStructure* ds, const char* key, const char* new_value);\nbool ds_remove(DataStructure* ds, const char* key);\nData* ds_search(DataStructure* ds, const char* key);\nsize_t ds_size(DataStructure* ds);\nbool ds_is_empty(DataStructure* ds);\nvoid ds_clear(DataStructure* ds);\nvoid ds_set_renderer(DataStructure* ds, Renderer* renderer);\nvoid ds_draw(DataStructure* ds, int x, int y, int width, int height);\n\nDataStructure* ds_create_hashmap(size_t capacity);\nDataStructure* ds_create_treemap(void);\n\n#endif\nEOF": {
            "approve": true,
            "matchCommandLine": true
        },
        "sed": true
    },
    "chat.agent.maxRequests": 100,
    "FSharp.suggestGitignore": false,
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false,
        "java": true
    },
    "editor.cursorStyle": "line",
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js, ${capture}.typegen.ts",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts, ${capture}.typegen.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.mts": "${capture}.typegen.ts",
        "*.cts": "${capture}.typegen.ts"
    },
    "chat.viewSessions.orientation": "stacked",
    "claudeCode.preferredLocation": "panel",
    "workbench.colorTheme": "GitHub Dark Dimmed",
}