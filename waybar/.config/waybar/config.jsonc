{
    "layer": "top",
    "spacing": 0,
    "height": 0,

    "margin-top": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "margin-left": 0,

    "corner-radius": 0,

    "include": [
        "~/.config/waybar/modules/workspaces.jsonc",
        "~/.config/waybar/modules/clock.jsonc",

        "~/.config/waybar/modules/group/rightgroup.jsonc",
        "~/.config/waybar/modules/group/hardware.jsonc"
    ],

    "modules-left": [
        "hyprland/workspaces"
    ],
 
    "modules-center": [
        "clock"
    ],

    "modules-right": [
        // "tray",
        // "cpu",
        // "memory",
        // "battery",
        // "network",
        // "backlight",
        // "pulseaudio",

        "group/hardware",
        "group/rightgroup"
    ]
}
