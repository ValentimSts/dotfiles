// ------------------
//
//  Workspaces
//
// ------------------

{
  "hyprland/workspaces": {
    "format": "{icon}",
    // the workspace buttons handle clicks themselves, so waybar does not
    // switch to the hand cursor on hover unless told to
    "cursor": true,
    "format-icons": {
      "active": "",
      "default": "",
      "empty": ""
    },
    "persistent-workspaces": {
      "*": [ 1,2,3,4,5 ]
    }
  }
}
