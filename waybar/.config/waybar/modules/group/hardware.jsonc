// ------------------
//
//  Hardware Group
//
// ------------------

{
    "include": [
        "~/.config/waybar/modules/cpu.jsonc",
        "~/.config/waybar/modules/memory.jsonc"
    ],

    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory"
            // "temperature"
        ]
    }
}
