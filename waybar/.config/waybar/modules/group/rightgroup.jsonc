{
  "include": [
    "~/.config/waybar/modules/language.jsonc",
    "~/.config/waybar/modules/group/quicksettings.jsonc"
  ],

  "group/rightgroup": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/language",
      "group/quicksettings"
    ]
  }
}
