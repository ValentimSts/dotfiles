// ------------------
//
//  Battery
//
// ------------------

{
  "battery": {
    "interval": 30,
    // The icon is drawn by styles/battery.css from these classes: lN is the
    // nearest tenth, for GNOME's battery-level-N icons. A state applies while
    // the charge is at or below its number, and the lowest matching one wins.
    "states": {
      "l0": 4,
      "l10": 14,
      "l20": 24,
      "l30": 34,
      "l40": 44,
      "l50": 54,
      "l60": 64,
      "l70": 74,
      "l80": 84,
      "l90": 94,
      "l100": 100
    },
    "format": "{capacity}%",
    "format-alt": "{time}",
    "format-alt-click": "click-right",
    "on-click": "~/.config/waybar/scripts/control-panel.sh"
  }
}
