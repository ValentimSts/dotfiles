// ------------------
//
//  Battery
//
// ------------------

{
  "battery": {
    "interval": 30,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "{capacity}% 󰂄 ",
    "format-alt": "{icon} {time}",
    "format-alt-click": "click-right",
    "on-click": "~/.config/waybar/scripts/control-panel.sh",
    "format-icons": ["󰁻", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"]
  }
}
