#!/bin/sh
# NetworkManager dispatcher script: stop auto-connecting to open Wi-Fi networks
# that sit behind a login page (a captive portal).
#
# When NetworkManager's connectivity check finds a login page on a Wi-Fi device
# and the network it joined has no password, the saved connection's autoconnect
# is turned off. The network stays saved and can still be joined by hand; it is
# just no longer picked by itself, where it would answer every request with its
# login page (pacman once saved that page as its database signatures).
#
# Open networks only. A network with a password that shows a login page for a
# while, such as a home router during an outage, keeps auto-connecting.
#
# Install as /etc/NetworkManager/dispatcher.d/90-captive-no-autoconnect, owned by
# root and writable by nobody else, or NetworkManager will not run it.
# NetworkManager calls it with the interface and the action.

action=${2:-}
case "$action" in
    up | connectivity-change) ;;
    *) exit 0 ;;
esac

nmcli -t -f TYPE,IP4-CONNECTIVITY,IP6-CONNECTIVITY,CON-UUID device status |
    while IFS=: read -r type ip4 ip6 uuid; do
        if [ "$type" != wifi ] || [ -z "$uuid" ]; then
            continue
        fi
        if [ "$ip4" != portal ] && [ "$ip6" != portal ]; then
            continue
        fi
        # No key management at all, or OWE, which encrypts but asks for no password.
        security=$(nmcli -g 802-11-wireless-security.key-mgmt connection show uuid "$uuid")
        case "$security" in
            "" | owe) ;;
            *) continue ;;
        esac
        if [ "$(nmcli -g connection.autoconnect connection show uuid "$uuid")" != yes ]; then
            continue
        fi
        if nmcli connection modify uuid "$uuid" connection.autoconnect no; then
            name=$(nmcli -g connection.id connection show uuid "$uuid")
            logger -t captive-no-autoconnect "login page on open network \"$name\": auto-connect turned off"
        fi
    done
exit 0
