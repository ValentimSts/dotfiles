# Secrets and machine-local state (never tracked)
**/secrets.sh
gh/.config/gh/hosts.yml

# Editor and tool noise
*.bak
*~
*.swp
.DS_Store

# Neovim plugin manager writes these at runtime
nvim/.config/nvim/plugin/

# Python bytecode from scripts/
__pycache__/

# Screenshots taken while working on the desktop: regenerable, and they can
# show Wi-Fi names and other things that do not belong in a public repo
.claude/playwright-screenshots/
