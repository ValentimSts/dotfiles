// Theme for the waybar power menu: a short list anchored under the power
// button at the top right. Colours and fonts come from config.rasi.
@import "config"

window {
    location:                    northeast;
    anchor:                      northeast;
    x-offset:                    -12px;
    y-offset:                    6px;
    width:                       240px;
}

mainbox {
    orientation:                 vertical;
    padding:                     6px;
    children:                    [ "listview" ];
}

listview {
    columns:                     1;
    lines:                       4;
    fixed-height:                false;
}

element {
    padding:                     8px 12px;
}

element-text {
    horizontal-align:            0.0;
}
