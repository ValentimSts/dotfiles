// Theme for wallpaper-picker: a grid of image previews.
// Colours and fonts come from config.rasi; only the layout changes here.
@import "config"

configuration {
    show-icons: true;
}

window {
    width:                       1100px;
}

mainbox {
    orientation:                 vertical;
    padding:                     12px;
    spacing:                     12px;
    children:                    [ "inputbar", "listview" ];
}

listview {
    columns:                     3;
    lines:                       2;
    flow:                        horizontal;
    spacing:                     12px;
    fixed-height:                false;
}

element {
    orientation:                 vertical;
    spacing:                     8px;
    padding:                     8px;
}

element-icon {
    size:                        320px;
}

element-text {
    horizontal-align:            0.5;
}
