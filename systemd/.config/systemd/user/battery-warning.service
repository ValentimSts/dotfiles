[Unit]
Description=Warn on screen when the battery runs low
PartOf=graphical-session.target
After=graphical-session.target eww.service
Wants=eww.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.config/eww/scripts/battery-warning.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
